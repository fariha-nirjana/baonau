{
  "name": "paws-for-thought-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "smoke": "tsx --env-file=../.env scripts/smoke.ts",
    "chat": "tsx --env-file=../.env scripts/chat.ts",
    "ask": "tsx --env-file=../.env scripts/ask.ts",
    "test": "tsx --test lib/*.test.ts components/*.test.ts",
    "keeper": "tsx --env-file=../.env scripts/keeper.ts",
    "attack": "tsx --env-file=../.env scripts/attack.ts",
    "owner": "tsx --env-file=../.env scripts/owner.ts",
    "autopilot": "tsx --env-file=../.env scripts/autopilot.ts",
    "harness": "tsx harness/run.ts",
    "copy": "tsx scripts/copy-export.ts",
    "redteam": "tsx --env-file=../.env redteam/run.ts",
    "story": "tsx --env-file=../.env scripts/story.ts",
    "demo": "bash ../scripts/demo.sh"
  },
  "dependencies": {
    "lottie-web": "5.13.0",
    "next": "16.4.0",
    "openai": "^7.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.57.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
