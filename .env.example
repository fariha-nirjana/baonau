# Copy to .env, or run scripts/new-env.sh to generate fresh testnet keys.
# Testnet keys only. Never put a key that holds real funds here.

# Chain: Base Sepolia
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
EXPLORER_URL=https://sepolia.basescan.org

# The three vault roles
OWNER_PRIVATE_KEY=
OWNER_ADDRESS=
GUARDIAN_PRIVATE_KEY=
GUARDIAN_ADDRESS=
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=

# The key that pushes prices to the oracle
ORACLE_UPDATER_PRIVATE_KEY=
ORACLE_UPDATER_ADDRESS=

# Waiting period before a looser rule takes effect, oldest price the vault
# accepts, and the shortest gap between two oracle updates. In seconds, short for the demo.
LOOSEN_DELAY=120
MAX_PRICE_AGE=3600
ORACLE_MIN_INTERVAL=4

# Filled in after deployment
USD_ADDRESS=
ORACLE_ADDRESS=
EXCHANGE_ADDRESS=
IDX_ADDRESS=
BOND_ADDRESS=
GOLD_ADDRESS=
MEME_ADDRESS=
FACTORY_ADDRESS=
MANDATE_ADDRESS=
VAULT_ADDRESS=

# Model provider (any OpenAI-compatible API)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
