# Copy to .env, or run scripts/new-env.sh to generate fresh testnet keys.
# Testnet keys only. Never put a key that holds real funds here.

# Chain: Base Sepolia
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
EXPLORER_URL=https://sepolia.basescan.org

# The three wallet roles
OWNER_PRIVATE_KEY=
OWNER_ADDRESS=
GUARDIAN_PRIVATE_KEY=
GUARDIAN_ADDRESS=
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=

# Demo payees (addresses only)
UNIVERSITY_ADDRESS=
LANDLORD_ADDRESS=

# Waiting periods in seconds. Short for the demo.
MANDATE_DELAY=120
LOOSEN_DELAY=120

# Filled in after deployment
TOKEN_ADDRESS=
WALLET_ADDRESS=
